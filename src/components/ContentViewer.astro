---
interface Props {
  content: string;
}

const { content } = Astro.props;
const lines = content.replace(/\r\n?/g, "\n").split("\n");
const lineNumberWidth = Math.max(2, String(lines.length).length);
---

<section class="content-panel">
  <pre class="source-code" style={`--line-number-width: ${lineNumberWidth}ch`}><code>{
    lines.map((line, index) => (
      <span class="source-line" data-line={index + 1}><span class="source-line-content">{line}</span></span>
    ))
  }</code></pre>
</section>
