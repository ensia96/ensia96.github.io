---
import type { RepositoryFile } from "@/lib/github";
import Icon from "@/components/Icon.astro";

interface Props {
  currentPath?: string;
  files: RepositoryFile[];
  prefix?: string;
}

const { currentPath, files, prefix = "" } = Astro.props;
const entries = files.map((file) => ({
  file,
  rest: file.path.slice(prefix.length),
}));
const directories = [
  ...new Set(
    entries
      .map(({ rest }) => rest.split("/")[0])
      .filter((name) => name && entries.some(({ rest }) => rest.startsWith(`${name}/`))),
  ),
].sort((a, b) => a.localeCompare(b));
const directFiles = entries
  .filter(({ rest }) => !rest.includes("/"))
  .sort((a, b) => a.rest.localeCompare(b.rest));
---

<ul>
  {
    directories.map((name) => (
      <li>
        <details open={currentPath?.startsWith(`${prefix}${name}/`)}>
          <summary>
            <Icon name="folder" class="tree-icon folder-icon" />
            <span>{name}</span>
          </summary>
          <Astro.self files={files} prefix={`${prefix}${name}/`} {currentPath} />
        </details>
      </li>
    ))
  }
  {
    directFiles.map(({ file, rest }) => (
      <li>
        <a href={file.href} aria-current={currentPath === file.path ? "page" : undefined}>
          <Icon name="file" class="tree-icon file-icon" />
          <span>{rest}</span>
        </a>
      </li>
    ))
  }
</ul>
