---
import DirectoryTree from "@/components/DirectoryTree.astro";
import Icon from "@/components/Icon.astro";
import type { Repository, RepositoryFile } from "@/lib/github";

interface Props {
  currentFile?: RepositoryFile;
  repositories: Repository[];
}

const { currentFile, repositories } = Astro.props;
const rootLabel = "~/projects/";
---

<div class="explorer">
  <nav aria-label="저장소 파일">
    <details class="nerdtree-help" data-nerdtree-help>
      <summary>&quot; Press ? for help</summary>
      <ul class="nerdtree-help-rows">
        <li><span>?</span><span>도움말</span></li>
        <li><span>Enter</span><span>파일 열기</span></li>
        <li><span>.git</span><span>GitHub</span></li>
        <li><span>.site</span><span>배포 사이트</span></li>
      </ul>
    </details>
    <a class="nerdtree-up"> </a>
    <a class="nerdtree-up" href="/">.. (up a dir)</a>
    <a class="nerdtree-root" href="/" title="GitHub 저장소 루트">{rootLabel}</a>
    {
      repositories.map((repository) => (
        <details class="repository" open>
          <summary>
            <Icon name="folder" class="tree-icon folder-icon" />
            <span>{repository.name}</span>
          </summary>
          <ul class="virtual-files">
            <li>
              <a
                href={repository.githubUrl}
                target="_blank"
                rel="noreferrer"
                aria-label={`${repository.name} GitHub (새 탭에서 열림)`}
              >
                <Icon name="external" class="tree-icon external-icon" />
                <span>.git</span>
              </a>
            </li>
            {repository.homepage && (
              <li>
                <a
                  href={repository.homepage}
                  target="_blank"
                  rel="noreferrer"
                  aria-label={`${repository.name} 배포 사이트 (새 탭에서 열림)`}
                >
                  <Icon name="external" class="tree-icon external-icon" />
                  <span>.site</span>
                </a>
              </li>
            )}
          </ul>
          <DirectoryTree
            files={repository.files}
            currentPath={currentFile?.repository === repository.name ? currentFile.path : undefined}
          />
        </details>
      ))
    }
  </nav>
</div>
