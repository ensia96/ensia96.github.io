---
import DirectoryTree from "@/components/DirectoryTree.astro";
import type { Repository } from "@/lib/github";

interface Props {
  repositories: Repository[];
}

const { repositories } = Astro.props;
---

{
  repositories.map((repository) => (
    <details open>
      <summary>
        {repository.homepage ? (
          <a href={repository.homepage}>{repository.name}</a>
        ) : (
          repository.name
        )}
      </summary>
      <DirectoryTree files={repository.files} />
    </details>
  ))
}
