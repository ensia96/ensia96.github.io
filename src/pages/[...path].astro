---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  getFileContent,
  getRepositories,
  type Repository,
  type RepositoryFile,
} from "@/lib/github";
import { renderMarkdown } from "@/lib/markdown";

export const getStaticPaths = (async () => {
  const repositories = await getRepositories();
  return repositories.flatMap((repository) =>
    repository.files.map((file) => ({
      params: { path: file.route },
      props: { file, repositories },
    })),
  );
}) satisfies GetStaticPaths;

interface Props {
  file: RepositoryFile;
  repositories: Repository[];
}

const { file, repositories } = Astro.props;
const content = await getFileContent(file);
const html = renderMarkdown(content);
const sourceLineCount = content.split(/\r?\n/).length;
const title = `${file.path.split("/").at(-1)} · 춤추는망고의 블로그`;
---

<BaseLayout
  {repositories}
  currentFile={file}
  {sourceLineCount}
  title={title}
  description={`${file.repository}의 ${file.path}`}
>
  <article class="document-content" set:html={html} />
</BaseLayout>
