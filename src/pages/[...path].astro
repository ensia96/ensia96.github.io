---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContentViewer from "@/components/ContentViewer.astro";
import {
  getFileContent,
  getRepositories,
  type Repository,
  type RepositoryFile,
} from "@/lib/github";

export const getStaticPaths = (async () => {
  const repositories = await getRepositories();
  return repositories.flatMap((repository) =>
    repository.files.map((file) => ({
      params: { path: file.route },
      props: { file, repositories },
    })),
  );
}) satisfies GetStaticPaths;

interface Props {
  file: RepositoryFile;
  repositories: Repository[];
}

const { file, repositories } = Astro.props;
const content = await getFileContent(file);
const isMarkdown = /\.(md|markdown)$/i.test(file.path);
const sourceLineCount = content.replace(/\r\n?/g, "\n").split("\n").length;
const title = `${file.path.split("/").at(-1)} · 춤추는망고의 블로그`;
---

<BaseLayout
  {repositories}
  currentFile={file}
  {sourceLineCount}
  title={title}
  description={`${file.repository}의 ${file.path}`}
>
  <ContentViewer {content} softWrap={isMarkdown} />
</BaseLayout>
