---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContentViewer from "@/components/ContentViewer.astro";
import {
  getFileContent,
  getRepositories,
  type Repository,
  type RepositoryFile,
} from "@/lib/github";
import { renderMarkdown } from "@/lib/markdown";

export const getStaticPaths = (async () => {
  const repositories = await getRepositories();
  return repositories.flatMap((repository) =>
    repository.files.map((file) => ({
      params: { path: file.route },
      props: { file, repositories },
    })),
  );
}) satisfies GetStaticPaths;

interface Props {
  file: RepositoryFile;
  repositories: Repository[];
}

const { file, repositories } = Astro.props;
const content = await getFileContent(file);
const repository = repositories.find(({ name }) => name === file.repository)!;
const isMarkdown = /\.(md|markdown)$/i.test(file.path);
const html = renderMarkdown(content, isMarkdown ? {
  owner: repository.owner,
  repository: repository.name,
  reference: repository.defaultBranch,
  path: file.path,
} : undefined);
const sourceLineCount = content.split(/\r?\n/).length;
const title = `${file.path.split("/").at(-1)} · 춤추는망고의 블로그`;
---

<BaseLayout
  {repositories}
  currentFile={file}
  {sourceLineCount}
  title={title}
  description={`${file.repository}의 ${file.path}`}
>
  {
    isMarkdown
      ? <ContentViewer {content} previewHtml={html} />
      : <article class="document-content" set:html={html} />
  }
</BaseLayout>
