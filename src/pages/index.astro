---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getRepositories } from "@/lib/github";

const repositories = await getRepositories();
---

<BaseLayout {repositories}>
  <section class="empty-buffer" aria-labelledby="empty-buffer-title">
    <h1 id="empty-buffer-title">춤추는망고</h1>
    <p>GitHub 저장소의 문서와 소스 코드를 탐색합니다.</p>
    <p class="empty-command">NERDTree에서 파일을 선택하세요.</p>
  </section>
</BaseLayout>
